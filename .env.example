# Хуулж .env нэртэй файл үүсгээд утгуудаа солино уу:  cp .env.example .env
# Сессийн cookie гарын үсэг зурах нууц түлхүүр. Заавал урт, санамсаргүй утга өгнө үү:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Өгөгдлийн сан (анхдагч: төслийн хавтас дахь SQLite файл)
# PostgreSQL жишээ: postgresql+psycopg://user:pass@localhost:5432/holboos
DATABASE_URL=sqlite:///./holboos.db

# Демо бүртгэлүүдийн нууц үг (зөвхөн хөгжүүлэлтэд). Өгөгдлийн санд hash хэлбэрээр хадгалагдана.
DEMO_PASSWORD=Holboos2026!

# Демо горим: нэвтрэх хуудсан дээр демо бүртгэлүүд, "дэмжлэг нэмэх" товч харагдана
DEMO_MODE=true

# Зураг оруулах дээд хэмжээ (MB)
MAX_UPLOAD_MB=5

# HTTPS орчинд true болгоно (cookie зөвхөн HTTPS-ээр дамжина)
SESSION_HTTPS_ONLY=false
